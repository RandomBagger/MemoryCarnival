# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Generate a password:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"

# Login for /admin (HTTP Basic). No default password: leave MC_ADMIN_PASSWORD
# empty and every admin route answers 503 instead of letting anyone in.
MC_ADMIN_USER=admin
MC_ADMIN_PASSWORD=
